{
	"name": "nuxt-app",
	"devDependencies": {
		"@iconify-json/akar-icons": "^1.2.0",
		"@iconify-json/fluent-emoji": "^1.2.1",
		"@iconify-json/line-md": "^1.2.1",
		"@iconify-json/material-symbols": "^1.2.2",
		"@iconify-json/mdi": "^1.2.0",
		"@iconify-json/ph": "^1.2.0",
		"@iconify-json/svg-spinners": "^1.2.0",
		"@nuxt/content": "^2.13.2",
		"@nuxt/eslint": "0.5.5",
		"@nuxt/fonts": "^0.7.2",
		"@nuxt/ui": "^2.21.0",
		"@nuxtjs/mdc": "0.12.0",
		"@nuxtjs/seo": "2.0.0-rc.20",
		"@nuxtjs/supabase": "^1.4.5",
		"jose": "^5.8.0",
		"monaco-editor": "0.50.0",
		"nuxt": "^3.15.4",
		"nuxt-aos": "1.2.5",
		"nuxt-monaco-editor": "^1.2.9",
		"prettier": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.6",
		"sass": "1.78.0",
		"vue": "^3.5.4",
		"vue-router": "^4.4.4"
	},
	"private": true,
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"generate": "nuxt generate",
		"preview": "nuxt preview",
		"postinstall": "nuxt prepare",
		"lint": "eslint . --fix",
		"format": "prettier --write .",
		"supatypes": "export POSTGRES_PASSWORD=$(grep '^POSTGRES_PASSWORD=' .env | cut -d '=' -f2-) && bunx supabase gen types --db-url=\"postgres://postgres:$POSTGRES_PASSWORD@db.portal.ort.spb.ru:5432/postgres\" --schema public > supabase/types.ts",
		"deploy-dev": "docker compose -f compose.build.preview.yaml build --push",
		"deploy-master": "docker compose -f compose.build.prod.yaml build --push",
		"deploy": "sh -c 'branch=$(git rev-parse --abbrev-ref HEAD) && if [ \"$branch\" = \"dev\" ]; then bun run deploy-dev; elif [ \"$branch\" = \"master\" ]; then bun run deploy-master; else echo \"Branch not recognized. No action taken.\"; fi'"
	},
	"trustedDependencies": [
		"@parcel/watcher",
		"esbuild",
		"sharp",
		"vue-demi"
	]
}